---
import { site } from '../data/site';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  headerMode?: 'default' | 'overlay';
}

const {
  title,
  description = site.description,
  pageClass = '',
  headerMode = 'default',
} = Astro.props;
const documentTitle = title ? `${title} · ${site.author.name}` : site.title;
const homeHref = site.navigation[0].href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f8f7" />
    <title>{documentTitle}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">跳至主要内容</a>
    <SiteHeader
      navigation={site.navigation}
      homeHref={homeHref}
      brandName={site.author.name}
      overlay={headerMode === 'overlay'}
    />
    <script is:inline>document.documentElement.classList.add('has-js');</script>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>在写作和创造中，给时间留下坐标。</p>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} {site.author.name}</span>
          <ul aria-label="社交链接">
            {site.socialLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <p class="footer-credit">首页图像：{site.assets.homeHero.credit}</p>
      </div>
    </footer>
  </body>
</html>
