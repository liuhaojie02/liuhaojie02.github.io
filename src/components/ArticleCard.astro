---
import type { CollectionEntry } from 'astro:content';
import { getReadingMinutes } from '../lib/content';
import ArticleMeta from './ArticleMeta.astro';

interface Props {
  entry: CollectionEntry<'articles'> | CollectionEntry<'notes'>;
  href: string;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
}

const { entry, href, headingLevel = 'h2', featured = false } = Astro.props;
const Heading = headingLevel;
const searchableText = [...entry.data.tags, entry.data.title].join(' ').toLocaleLowerCase();
---

<article
  class:list={['article-card', { 'article-card--featured': featured }]}
  data-tags={searchableText}
>
  {featured && <p class="article-card__featured-label">最新写作</p>}
  <ArticleMeta
    pubDate={entry.data.pubDate}
    readingMinutes={getReadingMinutes(entry.body ?? '')}
    tags={entry.data.tags}
  />
  <Heading><a class="article-card__title-link" href={href}>{entry.data.title}</a></Heading>
  <p>{entry.data.description}</p>
  <a class="text-link article-card__read-link" href={href} aria-label={`阅读《${entry.data.title}》`}>
    继续阅读 <span aria-hidden="true">→</span>
  </a>
</article>
