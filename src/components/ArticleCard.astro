---
import type { CollectionEntry } from 'astro:content';
import { getReadingMinutes } from '../lib/content';
import ArticleMeta from './ArticleMeta.astro';

interface Props {
  entry: CollectionEntry<'articles'> | CollectionEntry<'notes'>;
  href: string;
  headingLevel?: 'h2' | 'h3';
}

const { entry, href, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article class="article-card">
  <ArticleMeta
    pubDate={entry.data.pubDate}
    readingMinutes={getReadingMinutes(entry.body ?? '')}
    tags={entry.data.tags}
  />
  <Heading><a href={href}>{entry.data.title}</a></Heading>
  <p>{entry.data.description}</p>
  <a class="text-link" href={href} aria-label={`阅读《${entry.data.title}》`}>
    继续阅读 <span aria-hidden="true">→</span>
  </a>
</article>
