---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  marker: string;
  backgroundSrc: string;
}

const {
  eyebrow,
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  marker,
  backgroundSrc,
} = Astro.props;
---

<section class="home-hero" aria-labelledby="hero-title">
  <img
    class="home-hero__background"
    src={backgroundSrc}
    alt=""
    width="4200"
    height="2800"
    loading="eager"
    fetchpriority="high"
  />
  <div class="home-hero__overlay" aria-hidden="true"></div>
  <div class="shell home-hero__content">
    <p class="home-hero__eyebrow">{eyebrow}</p>
    <div class="home-hero__title"><h1 id="hero-title">{title}</h1></div>
    <p class="home-hero__copy">{description}</p>
    <div class="home-hero__actions">
      <a class="home-hero__cta" href={primaryHref}>
        {primaryLabel} <span aria-hidden="true">→</span>
      </a>
      <a class="home-hero__secondary-link" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
  <p class="home-hero__marker" aria-hidden="true">{marker}</p>
</section>
