---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}

const { eyebrow, title, description, href, linkLabel, id } = Astro.props;
---

<header class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {href && linkLabel && <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>}
</header>
