---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBasePath } from '../data/site';
---

<BaseLayout title="页面未找到" pageClass="error-page">
  <section class="not-found shell" aria-labelledby="not-found-title">
    <p class="error-code">404</p>
    <h1 id="not-found-title">这一页还没有写下来。</h1>
    <p>你访问的地址不存在，或者已经被移动。可以回到首页，从最新的内容继续。</p>
    <a class="button-link" href={withBasePath('')}>返回首页 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
