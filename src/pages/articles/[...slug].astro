---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleMeta from '../../components/ArticleMeta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toBaseAwareAssetUrl, withBasePath } from '../../data/site';
import { getPublishedEntries, getReadingMinutes } from '../../lib/content';

export async function getStaticPaths() {
  const articles = getPublishedEntries(await getCollection('articles'));

  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const coverUrl = entry.data.cover ? toBaseAwareAssetUrl(entry.data.cover) : undefined;
---

<BaseLayout title={entry.data.title} description={entry.data.description} pageClass="article-page">
  <article class="article-shell shell">
    <header class="article-header">
      <a class="back-link" href={withBasePath('articles/')}>← 返回文章</a>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      <ArticleMeta
        pubDate={entry.data.pubDate}
        readingMinutes={getReadingMinutes(entry.body ?? '')}
        tags={entry.data.tags}
      />
    </header>
    {coverUrl && <img class="article-cover" src={coverUrl} alt="" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
